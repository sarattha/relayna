# Relayna Studio backend
RELAYNA_STUDIO_REDIS_URL=redis://127.0.0.1:6379/0

# Shared Entra application, Studio-specific callback and certificate
RELAYNA_STUDIO_ENTRA_APPLICATION_ID=relayna-gateway-local
RELAYNA_STUDIO_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000001
RELAYNA_STUDIO_ENTRA_ISSUER=http://127.0.0.1:18090
RELAYNA_STUDIO_ENTRA_OIDC_DISCOVERY_URL=http://127.0.0.1:18090/.well-known/openid-configuration
RELAYNA_STUDIO_ENTRA_OIDC_REDIRECT_URI=http://127.0.0.1:5173/studio/auth/callback
RELAYNA_STUDIO_ENTRA_OIDC_PRIVATE_KEY_PATH=/tmp/relayna-studio-oidc/portal-private-key.pem
RELAYNA_STUDIO_ENTRA_OIDC_CERTIFICATE_PATH=/tmp/relayna-studio-oidc/portal-certificate.pem

# Bootstrap both values together. Remove both after an active admin is stored.
RELAYNA_STUDIO_ENTRA_ADMIN_EMAILS=gateway.admin@relayna.dev
RELAYNA_STUDIO_ENTRA_ADMIN_OBJECT_IDS=00000000-0000-0000-0000-000000000002

RELAYNA_STUDIO_SESSION_TTL_SECONDS=28800
RELAYNA_STUDIO_LOGIN_TTL_SECONDS=600
# Development HTTP only. Keep true behind production HTTPS.
RELAYNA_STUDIO_SESSION_COOKIE_SECURE=false
